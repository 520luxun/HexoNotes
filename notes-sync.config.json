{
  "source": "D:/ObsidianFirstNotes",
  "target": "src/content/posts/notes",
  "publishField": "publish",
  "alwaysInclude": [
    "Blog/**",
    "blog/**",
    "Embedded/**",
    "Study/**"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.obsidian/**",
    "**/.claude/**",
    "**/.venv/**",
    "**/assets/**",
    "**/asserts/**",
    "**/Clippings/**",
    "**/Daily/**",
    "**/Excalidraw/**",
    "**/.*/**"
  ],
  "defaultCategory": "笔记",
  "categoryMap": {
    "Embedded": "嵌入式",
    "Study": "学习笔记",
    "Blog": "笔记"
  },
  "copyAttachments": true
}
