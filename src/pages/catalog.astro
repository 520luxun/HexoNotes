---
import ArchivePanel from "@components/ArchivePanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";

// 总目录：与归档同款展示，但按分类分组、组内保持章节顺序。
const posts = await getSortedPostsList();
---

<MainGridLayout title="总目录">
    <ArchivePanel sortedPosts={posts} client:only="svelte" mode="catalog"></ArchivePanel>
</MainGridLayout>
