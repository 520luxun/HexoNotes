---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostUrlBySlug } from "@utils/url-utils";
import { getSortedPosts } from "../utils/content-utils";

// 总目录：按分类层级缩进，父级一行、子级缩进、文章再缩进；窄屏可横向滚动。
const posts = await getSortedPosts();

const chapterKey = (title: string) => {
	const m = title.match(/^(\d+(?:\.\d+)*)/);
	return m
		? m[1]
				.split(".")
				.map((n) => n.padStart(4, "0"))
				.join(".")
		: "9999";
};

const sorted = [...posts].sort((a, b) =>
	chapterKey(a.data.title).localeCompare(chapterKey(b.data.title)),
);

type Node = { label: string; posts: typeof sorted; children: Map<string, Node> };
const root: Node = { label: "", posts: [], children: new Map() };

for (const post of sorted) {
	const segments = String(post.data.category ?? "未分类").split("/").filter(Boolean);
	let node = root;
	for (const segment of segments) {
		let child = node.children.get(segment);
		if (!child) {
			child = { label: segment, posts: [], children: new Map() };
			node.children.set(segment, child);
		}
		node = child;
	}
	node.posts.push(post);
}

const escapeHtml = (s: string) =>
	String(s)
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;");

const countOf = (n: Node): number =>
	n.posts.length + [...n.children.values()].reduce((sum, c) => sum + countOf(c), 0);

const formatDate = (d: Date) => {
	const date = new Date(d);
	return `${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
};

const rows: string[] = [];

const walk = (node: Node, depth: number) => {
	for (const child of [...node.children.values()].sort((a, b) =>
		a.label.localeCompare(b.label, "zh"),
	)) {
		rows.push(
			`<div class="flex items-baseline gap-3 py-2" style="padding-left:${depth * 1.5}rem">` +
				`<span class="font-bold text-lg whitespace-nowrap">${escapeHtml(child.label)}</span>` +
				`<span class="text-75 text-xs">${countOf(child)} 篇</span>` +
				`</div>`,
		);
		walk(child, depth + 1);
	}
	for (const post of node.posts) {
		rows.push(
			`<div class="flex items-baseline gap-3 py-1" style="padding-left:${depth * 1.5 + 1.5}rem">` +
				`<span class="text-50 text-xs w-12 shrink-0">${formatDate(post.data.published)}</span>` +
				`<a class="link text-sm font-bold whitespace-nowrap" href="${getPostUrlBySlug(post.slug)}">${escapeHtml(post.data.title)}</a>` +
				`</div>`,
		);
	}
};

walk(root, 0);
---

<MainGridLayout title="总目录">
    <div class="card-base px-6 py-6">
        <h1 class="text-3xl font-bold mb-1">总目录</h1>
        <p class="text-75 text-sm mb-5">共 {posts.length} 篇 · 按分类层级与章节顺序排列</p>
        <div class="overflow-x-auto">
            <div class="min-w-[30rem]" set:html={rows.join("")} />
        </div>
    </div>
</MainGridLayout>
