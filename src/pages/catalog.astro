---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostUrlBySlug } from "@utils/url-utils";
import { getSortedPosts } from "../utils/content-utils";

// 总目录：分类层级用 <details> 折叠，文章按章节号排序，窄屏可横向滚动。
const posts = await getSortedPosts();

const chapterKey = (title: string) => {
	const m = title.match(/^(\d+(?:\.\d+)*)/);
	return m
		? m[1]
				.split(".")
				.map((n) => n.padStart(4, "0"))
				.join(".")
		: "9999";
};

const sorted = [...posts].sort((a, b) =>
	chapterKey(a.data.title).localeCompare(chapterKey(b.data.title)),
);

type Node = { label: string; posts: typeof sorted; children: Map<string, Node> };
const root: Node = { label: "", posts: [], children: new Map() };

// 目录页专属的二级分组：分类名 -> 从 slug 路径推断子分组。
// 只影响总目录页，侧边栏分类（frontmatter 的 category）保持扁平不变。
const CATALOG_GROUPS: Record<string, (post: (typeof sorted)[number]) => string[]> = {
	硬件电路: (post) => {
		// slug 形如 notes/嵌入式/硬件电路/<文件夹>/<笔记>。
		// 只有紧跟「硬件电路」的文件夹是「基础知识点」时（即 1-1 ~ 1-7）
		// 归入基础知识点，其余（扩展资料 + 根级说明文档）全部归入扩展资料。
		const parts = String(post.slug).split("/");
		const i = parts.indexOf("硬件电路");
		const section = i >= 0 ? parts[i + 1] : "";
		return section === "基础知识点"
			? ["硬件电路", "基础知识点"]
			: ["硬件电路", "扩展资料"];
	},
};

for (const post of sorted) {
	const category = String(post.data.category ?? "未分类");
	const groupFn = CATALOG_GROUPS[category];
	const segments = groupFn
		? groupFn(post)
		: category.split("/").filter(Boolean);
	let node = root;
	for (const segment of segments) {
		let child = node.children.get(segment);
		if (!child) {
			child = { label: segment, posts: [], children: new Map() };
			node.children.set(segment, child);
		}
		node = child;
	}
	node.posts.push(post);
}

const escapeHtml = (s: string) =>
	String(s)
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;");

const countOf = (n: Node): number =>
	n.posts.length + [...n.children.values()].reduce((sum, c) => sum + countOf(c), 0);

const formatDate = (d: Date) => {
	const date = new Date(d);
	return `${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
};

const render = (node: Node, depth: number): string => {
	let html = "";
	const children = [...node.children.values()].sort((a, b) =>
		a.label.localeCompare(b.label, "zh"),
	);
	for (const child of children) {
		html +=
			`<details class="py-1" style="padding-left:${depth * 1.25}rem" ${depth === 0 ? "open" : ""}>` +
			`<summary class="cursor-pointer select-none font-bold text-lg py-2 px-3 rounded-xl whitespace-nowrap transition hover:bg-[var(--btn-plain-bg-hover)] flex items-center gap-2">` +
			`<span class="inline-block w-2 h-2 rounded-full bg-[var(--primary)] shadow-[0_0_8px_var(--primary)]"></span>` +
			`<span>${escapeHtml(child.label)}</span>` +
			`<span class="text-xs font-normal px-2 py-0.5 rounded-full bg-[var(--btn-regular-bg)] text-75">${countOf(child)} 篇</span>` +
			`</summary>` +
			`<div class="ml-3 border-l border-[var(--line-color)] pl-2">${render(child, depth + 1)}</div>` +
			`</details>`;
	}
	for (const post of node.posts) {
		html +=
			`<div class="flex items-baseline gap-3 py-1.5 px-2 rounded-lg transition hover:bg-[var(--btn-plain-bg-hover)]" style="padding-left:${depth * 1.25 + 1.25}rem">` +
			`<span class="text-50 text-xs font-mono w-12 shrink-0">${formatDate(post.data.published)}</span>` +
			`<a class="link text-sm font-bold whitespace-nowrap" href="${getPostUrlBySlug(post.slug)}">${escapeHtml(post.data.title)}</a>` +
			`</div>`;
	}
	return html;
};

const html = render(root, 0);
---

<MainGridLayout title="总目录">
    <div class="card-base px-6 py-6">
        <div class="flex items-center justify-between mb-1">
            <h1 class="text-3xl font-bold">总目录</h1>
            <div class="flex gap-2">
                <button class="btn-regular text-sm px-3 py-1" onclick="document.querySelectorAll('#catalog details').forEach(d=>d.open=true)">全部展开</button>
                <button class="btn-regular text-sm px-3 py-1" onclick="document.querySelectorAll('#catalog details').forEach(d=>d.open=false)">全部收起</button>
            </div>
        </div>
        <p class="text-75 text-sm mb-5">共 {posts.length} 篇 · 点击分类可展开/收起</p>
        <div id="catalog" class="overflow-x-auto">
            <div class="min-w-[30rem]" set:html={html} />
        </div>
    </div>
</MainGridLayout>
