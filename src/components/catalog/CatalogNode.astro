---
import {
	type CatalogNode as CatalogNodeData,
	countPosts,
	formatShortDate,
	sortedChildren,
} from "@utils/catalog-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import CatalogNodeView from "./CatalogNode.astro";

interface Props {
	node: CatalogNodeData;
	depth?: number;
	/** 首屏只展示前 N 篇文章，其余折叠到「展开剩余」。仅卡片根部使用。 */
	limit?: number;
}

const { node, depth = 0, limit = 0 } = Astro.props;
const kids = sortedChildren(node);
const visible =
	limit > 0 ? Math.min(limit, node.posts.length) : node.posts.length;
// 只有一层子目录、自己又没有文章时（例如 NoSystematic → Docs），
// 直接展开这一层，免得卡片里只剩一行「Docs 64」。
const openSoleGroup =
	depth <= 1 && node.posts.length === 0 && kids.length === 1;
---

{kids.map((child) => (
	<details class="cat-group" data-node open={openSoleGroup}>
		<summary
			class="flex cursor-pointer select-none list-none items-center gap-2 rounded-lg px-2.5 py-1.5 transition-colors hover:bg-[var(--btn-plain-bg-hover)]"
		>
			<Icon
				name="fa6-solid:chevron-right"
				class="cat-chev h-2.5 w-2.5 shrink-0 text-30"
			/>
			<span
				class:list={[
					"min-w-0 flex-1 truncate text-75",
					depth === 0 ? "text-[13px] font-semibold" : "text-[12.5px] font-medium",
				]}
			>
				{child.label}
			</span>
			<span class="shrink-0 font-mono text-[10.5px] tabular-nums text-30">
				{countPosts(child)}
			</span>
		</summary>
		<div class="ml-[0.85rem] mt-0.5 border-l border-black/[0.06] pl-1.5 dark:border-white/[0.08]">
			<CatalogNodeView node={child} depth={depth + 1} />
		</div>
	</details>
))}

{node.posts.map((post, index) => (
	<a
		href={getPostUrlBySlug(post.slug)}
		data-post
		data-title={String(post.data.title).toLowerCase()}
		title={String(post.data.title)}
		class:list={[
			"cat-row group/row flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 transition-colors hover:bg-[var(--btn-plain-bg-hover)]",
			index >= visible && "cat-extra hidden",
		]}
	>
		<span class="w-10 shrink-0 font-mono text-[10.5px] tabular-nums text-30">
			{formatShortDate(post.data.published)}
		</span>
		<span class="min-w-0 flex-1 truncate text-[12.5px] text-75 transition-colors group-hover/row:text-[var(--primary)]">
			{String(post.data.title)}
		</span>
		<Icon
			name="fa6-solid:angle-right"
			class="h-2.5 w-2.5 shrink-0 text-30 opacity-0 transition-all group-hover/row:translate-x-0.5 group-hover/row:opacity-100"
		/>
	</a>
))}

{limit > 0 && node.posts.length > limit && (
	<button
		type="button"
		data-more
		class="mt-1.5 flex w-full items-center justify-center gap-1.5 rounded-lg border border-dashed border-black/10 py-1.5 text-[11.5px] text-30 transition-colors hover:border-[var(--cat)] hover:text-[var(--cat)] dark:border-white/15"
	>
		<Icon name="fa6-solid:angles-down" class="h-2.5 w-2.5" />
		<span>展开剩余 {node.posts.length - limit} 篇</span>
	</button>
)}

<style>
	.cat-group > summary::-webkit-details-marker {
		display: none;
	}
	.cat-group > summary .cat-chev {
		transition: transform 0.2s ease;
	}
	.cat-group[open] > summary .cat-chev {
		transform: rotate(90deg);
	}
</style>
